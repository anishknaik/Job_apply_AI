# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Stage B scoring provider ----------------------------------------------
# gemini (default) or anthropic. Switching providers is a config change; see
# jobpipe/providers/.
JOBPIPE_PROVIDER=gemini

# --- Google Gemini ----------------------------------------------------------
# Either name works; the SDK reads GEMINI_API_KEY, and GOOGLE_API_KEY is
# accepted as an alias.
#
# The key MUST belong to a billing-enabled project. Google's free tier permits
# using submitted prompts to improve their products, and this prompt contains
# a full personal career profile. Billing changes the data policy, not just
# the rate limits.
GEMINI_API_KEY=

# Default scoring model, and the escalation model for borderline scores (5-7).
#
# NOTE: gemini-2.5-flash-lite is NOT usable — verified 2026-08-12, the API
# returns "no longer available to new users" for a freshly created key.
JOBPIPE_SCORING_MODEL=gemini-3.1-flash-lite
JOBPIPE_ESCALATION_MODEL=gemini-3.5-flash-lite

# --- Anthropic (final rung of the escalation ladder) ------------------------
# Only needed if JOBPIPE_PROVIDER=anthropic. This is the pay-as-you-go API
# key, NOT your Pro subscription — separate billing systems.
#
# Keep it out of your interactive shell profile: an exported ANTHROPIC_API_KEY
# silently causes Claude Code to bill the API instead of the subscription.
# Loading it from this file at runtime (python-dotenv) avoids that.
ANTHROPIC_API_KEY=

# Stop and warn rather than scoring more than this in a single run.
JOBPIPE_MAX_SCORES_PER_RUN=600

# --- Master profile ---------------------------------------------------------
# Path to the long-form profile document (3,000+ words). Cached in the scoring
# system prompt with a 1-hour breakpoint.
JOBPIPE_PROFILE_PATH=config/master_profile.md

# --- Google Sheets ----------------------------------------------------------
# Service account: no browser, no token refresh, no re-consent under cron.
# Share the target sheet with the service account's client_email as an editor.
GOOGLE_SERVICE_ACCOUNT_JSON=config/service_account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=roles

# Resume rendering (Phase 2 §3.2). Lower to 9.0 for a denser one-page resume
# matching the hand-built one; verified to extract cleanly. Default 10.0.
JOBPIPE_MIN_FONT_PT=10.0

# Phase 2 cover letter prose (spec 5). Quality-sensitive; not cost-optimised.
JOBPIPE_PROSE_MODEL=gemini-3.5-flash

# Phase 2: max documents generated in one `tailor --queued` batch.
JOBPIPE_MAX_DOCS_PER_RUN=40

# --- Vertex AI backend (PHASE5_PLAN Track A) -----------------------------
# Same Gemini models, different billing door. The Developer API key above
# bills to a track that Google Cloud promotional credits cannot pay for;
# Vertex bills to the GCP billing account where the credits live, and carries
# enterprise data-governance terms rather than a free tier that permits
# training on submitted prompts.
#
# Unset (or `api`) keeps the Developer API. Rollback is deleting one line.
#
# Flipping this does NOT change which model runs - that is deliberate, so the
# backend change can be verified before the model changes underneath it.
#
# The service account needs roles/aiplatform.user on the project. The Sheets
# account already has it; GOOGLE_SERVICE_ACCOUNT_JSON above is reused, so
# there is no second key to manage.
#
# GOOGLE_CLOUD_LOCATION: `global` works for every model tested.
# gemini-2.5-flash also resolves at us-central1; gemini-3.1-flash-lite 404s
# regionally, so `global` is the safe default while 3.x is still configured.
#JOBPIPE_GEMINI_BACKEND=vertex
#GOOGLE_CLOUD_PROJECT=gen-lang-client-0077852111
#GOOGLE_CLOUD_LOCATION=global
